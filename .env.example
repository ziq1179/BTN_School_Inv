# Database - Local PostgreSQL (development)
# Use your Neon direct URL for production/migrations, pooler for serverless runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_inventory"
# Direct (unpooled) connection used for migrations. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/school_inventory"

# Session secret - change in production!
SESSION_SECRET="your-secret-key-change-in-production"

# Stripe billing (test keys from dashboard.stripe.com/test/apikeys)
# Product + recurring price are created via the Stripe API; paste the price id here.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRO_PRICE_ID="price_..."

# Groq API key for AI features (console.groq.com) - never committed
# GROQ_API_KEY="gsk_..."

# Environment
NODE_ENV="development"

# Local server port (default: 3000)
# PORT=3000
